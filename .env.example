# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/openbrain

# ─── Embedding Provider ───────────────────────────────────────────────────────
# 'ollama' = local/free (default)   |   'openai' = API-based
EMBEDDING_PROVIDER=ollama

# Dimensions must match the model you choose:
#   nomic-embed-text  → 768
#   mxbai-embed-large → 1024
#   text-embedding-3-small (OpenAI) → 1536
EMBEDDING_DIMENSIONS=768

# ─── Ollama (local, free) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── OpenAI (optional, costs ~$0.00002 per thought) ──────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Metadata Extraction (optional) ──────────────────────────────────────────
# Set to a local Ollama model (e.g. qwen2.5:32b, llama3.2:3b) for richer
# metadata (people, topics, type). Leave blank for fast heuristic extraction.
# If Ollama runs on Windows and this server runs from WSL, keep
# OLLAMA_BASE_URL=http://localhost:11434 and enable mirrored networking in
# C:\Users\<USERNAME>\.wslconfig with:
#   [wsl2]
#   localhostForwarding=true
#   networkingMode=mirrored
# If you use both a metadata model and nomic-embed-text, start Ollama with
# OLLAMA_MAX_LOADED_MODELS=2 to avoid repeated model evictions.
METADATA_LLM_MODEL=

# ─── Transport ──────────────────────────────────────────────────────────────
# MCP HTTP port (for claude.ai connectors)
OPEN_BRAIN_PORT=8080
OPEN_BRAIN_HOST=0.0.0.0

# REST API port (for remote clients: Co-work, Cursor, web UIs, custom tools)
OPEN_BRAIN_REST_PORT=8765
OPEN_BRAIN_REST_HOST=0.0.0.0

# REST API key — auto-generated on first run. Never share it.
# Clients authenticate via POST /pair (token-based, no key needed).
OPEN_BRAIN_API_KEY=

# Auto-start ngrok tunnel for remote access (true/false)
# When true, the public URL is discoverable at GET /health
OPEN_BRAIN_TUNNEL=true

# Session token TTL in hours (clients re-pair after expiry)
OPEN_BRAIN_TOKEN_TTL_HOURS=24

# ─── Dedup & Compliance ────────────────────────────────────────────────────
DEDUP_THRESHOLD=0.92
COMPLIANCE_WINDOW=300

# ─── Memory Retrieval Tuning ──────────────────────────────────────────────
# Recency decay: memories not accessed recently score lower in search results.
# score = similarity * exp(-lambda * days_since_last_access)
# 0.005 = ~86% at 30 days, ~41% at 180 days. Set to 0 to disable.
OPEN_BRAIN_DECAY_LAMBDA=0.005

# Hybrid search: weight for full-text (keyword) component vs vector similarity.
# Final score = (1 - weight) * vector_score + weight * fts_rank
# 0.3 = 70% semantic, 30% keyword. Set to 0 for pure vector (no migration needed).
# When > 0, a tsvector column and GIN index are auto-added to the DB on first start.
OPEN_BRAIN_HYBRID_WEIGHT=0.3
