# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/openbrain

# ─── Embedding Provider ───────────────────────────────────────────────────────
# 'ollama' = local/free (default)   |   'openai' = API-based
EMBEDDING_PROVIDER=ollama

# Dimensions must match the model you choose:
#   nomic-embed-text  → 768
#   mxbai-embed-large → 1024
#   text-embedding-3-small (OpenAI) → 1536
EMBEDDING_DIMENSIONS=768

# ─── Ollama (local, free) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── OpenAI (optional, costs ~$0.00002 per thought) ──────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Metadata Extraction (optional) ──────────────────────────────────────────
# Set to a local Ollama model (e.g. qwen2.5:32b, llama3.2:3b) for richer
# metadata (people, topics, type). Leave blank for fast heuristic extraction.
# If Ollama runs on Windows and this server runs from WSL, keep
# OLLAMA_BASE_URL=http://localhost:11434 and enable mirrored networking in
# C:\Users\DAVE\.wslconfig with:
#   [wsl2]
#   localhostForwarding=true
#   networkingMode=mirrored
# If you use both a metadata model and nomic-embed-text, start Ollama with
# OLLAMA_MAX_LOADED_MODELS=2 to avoid repeated model evictions.
METADATA_LLM_MODEL=
